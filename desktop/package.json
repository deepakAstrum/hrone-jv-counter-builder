{
  "name": "hrone-counter-builder-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Windows desktop edition of HROne Counter Builder.",
  "main": "electron/main.mjs",
  "author": "Deepak Basera",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "build": {
    "appId": "com.hrone.counterbuilder",
    "productName": "HROne Counter Builder",
    "electronVersion": "43.2.0",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "../outputs/windows"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/main.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HROne Counter Builder",
      "uninstallDisplayName": "HROne Counter Builder"
    }
  }
}
